library identifier: "jenkins-shared-libraries@$env.DEFAULT_LIBRARY_BRANCH", changelog: false
pipeline {
  agent { label 'ec2-agent-base' }

  environment {
    def mavenPom = readMavenPom()
    ARTIFACT_ID = mavenPom.getArtifactId()
  }

  stages {

    // <revision> in pom.xml is set once (3.0.0-SNAPSHOT) and never bumped by hand. readMavenPom() returns
    // the unresolved ${revision} as the version, so read the property instead. On production the published
    // version is <base>-<UTC timestamp>, e.g. 3.0.0-20261111103000, passed to Maven as -Drevision.
    stage('Resolve version') {
      steps {
        script {
          // Jenkins script sandbox rejects java.util.Properties.getProperty, so read <revision> with sed.
          def base = sh(script: "sed -n 's:.*<revision>\\(.*\\)-SNAPSHOT</revision>.*:\\1:p' pom.xml | head -1",
              returnStdout: true).trim()
          def timestamp = sh(script: 'date -u +%Y%m%d%H%M%S', returnStdout: true).trim()
          if (!base) {
            error("No <revision>X-SNAPSHOT</revision> found in pom.xml")
          }
          env.PUBLISH_VERSION = "${base}-${timestamp}"
          currentBuild.description = "$ARTIFACT_ID ${base}-SNAPSHOT (publish ${env.PUBLISH_VERSION})"
        }
      }
    }

    stage('Test') {
      steps {
        mvnCleanInstall(mvnArgs: ["--activate-profiles ginmon-internal,jenkins", "-Drevision=${env.PUBLISH_VERSION}"], jdk: "JAVA21")
      }
    }

    // Only the production branch publishes. master stays SNAPSHOT and never deploys.
    // A plain Git-SCM pipeline (not multibranch) leaves BRANCH_NAME unset and sets GIT_BRANCH to
    // "origin/production", so `branch 'production'` never matches. Check both.
    stage('Deploy Release Artifact') {
      when {
        expression {
          def branch = env.BRANCH_NAME ?: env.GIT_BRANCH ?: ''
          return branch == 'production' || branch == 'origin/production'
        }
      }
      steps {
        // Clean and rebuild at the publish version. Deploying the Test stage's target/ would ship the
        // 3.0.0-SNAPSHOT jar. mvnDeploy cannot add `clean` (it appends args after `deploy`), so call mvn.
        mvn([
            "clean deploy --update-snapshots",
            "--activate-profiles ginmon-internal,jenkins",
            "-Drevision=${env.PUBLISH_VERSION}",
            "-DskipTests"
          ],
          "JAVA21")
      }
    }
  }

  post('Notify Slack') {
    always {
      slackNotify(currentBuild.currentResult)
    }
  }
}
